[Unit]
Description=Decrypt backend credentials into runtime tmpfs
Before=sf-backend-compose.service

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
EnvironmentFile=/etc/shattered-frontier/backend.env
ExecStartPre=/usr/bin/install -d -m 0700 /run/sf-secrets
ExecStartPre=/usr/bin/mount -t tmpfs -o size=1m,mode=0700 tmpfs /run/sf-secrets
ExecStart=/bin/sh /opt/shattered-frontier/backend/decrypt-secrets.sh
ExecStop=/usr/bin/umount /run/sf-secrets

[Install]
WantedBy=sf-backend-compose.service
